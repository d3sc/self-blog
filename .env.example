# Copy to .env and replace every placeholder before starting Compose.
# Do not commit .env. Generate secrets with: openssl rand -hex 32
APP_ENV=development
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Local HTTP requires false. Set true only when the public URL is HTTPS.
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Host binding defaults to localhost. Production must use a TLS reverse proxy and COOKIE_SECURE=true.
FRONTEND_BIND=127.0.0.1
FRONTEND_HOST_PORT=3000
FRONTEND_PORT=3000
BACKEND_PORT=8080
API_INTERNAL_URL=http://backend:8080/api/v1
POSTGRES_VOLUME_NAME=blog_cms_postgres_data
